{
  "manifestVersion": 5,
  "id": "com.eddie.tools.alpha",
  "name": "Eddie Tools Alpha",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "20.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "eddieToolsPanel",
      "label": {
        "default": "Eddie Tools"
      }
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    }
  }
}